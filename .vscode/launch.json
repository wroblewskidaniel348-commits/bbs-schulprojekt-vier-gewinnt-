{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Vier Gewinnt debuggen (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\VierGewinnt.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\ucrt64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "GDB: STL-Ausgabe lesbar machen",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C++ Build (Vier Gewinnt)"
        },
        {
            "name": "Regeltests debuggen (GDB)",
